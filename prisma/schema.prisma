model PTLevel {
  id                 String               @id @default(cuid())
  name               String
  order              Int
  color              String               @default("#6b7280")
  retestIntervalDays Int                  @default(30)
  // KPI doanh số/tháng (triệu) của cấp độ — dùng để tính hiệu suất doanh số (hiệu suất = doanh số thực / KPI).
  // Cấp độ "Thử việc" đặt 15, các cấp PT chính thức để 38.
  monthlyTarget      Int                  @default(38)
  // Điều kiện để PT ở cấp này được THĂNG lên cấp kế tiếp:
  // - promoteMinAvgRevenue: TB doanh số/tháng tối thiểu (triệu). VD Thử việc 15, Cấp 1-3 = 80%×38 = 30.4
  // - promoteMinTransform: số khách đạt transform tối thiểu. VD Thử việc 0, Cấp 1-3 = 1
  promoteMinAvgRevenue Float              @default(0)
  promoteMinTransform  Int                @default(0)
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  phaseAccess        PTLevelPhaseAccess[]
  users              User[]               @relation("UserPTLevel")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("pt_levels")
}

