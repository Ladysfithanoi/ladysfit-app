  year                Int
  checkinImages       String?  @db.Text
  transformImages     String?  @db.Text
  hasTransformed      Boolean  @default(false)
  createdAt           DateTime @default(now())

  pt                User              @relation("PTSessionPhotos", fields: [ptId], references: [id], onDelete: Cascade)
  client            Client            @relation("ClientSessionPhotos", fields: [clientId], references: [id], onDelete: Cascade)
  packageEnrollment PackageEnrollment @relation(fields: [packageEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([ptId, packageEnrollmentId, month, year])
  @@map("session_photos")
}

// ── PT Level System ───────────────────────────────────────────────────────────

model PTLevel {
  id                 String               @id @default(cuid())
  name               String
  order              Int
  color              String               @default("#6b7280")
  retestIntervalDays Int                  @default(30)
  // KPI doanh số/tháng (triệu) của cấp độ — dùng để tính hiệu suất doanh số (hiệu suất = doanh số thực / KPI).
  // Cấp độ "Thử việc" đặt 15, các cấp PT chính thức để 38.
  monthlyTarget      Int                  @default(38)
  // Điều kiện để PT ở cấp này được THĂNG lên cấp kế tiếp:
  // - promoteMinAvgRevenue: TB doanh số/tháng tối thiểu (triệu). VD Thử việc 15, Cấp 1-3 = 80%×38 = 30.4
  // - promoteMinTransform: số khách đạt transform tối thiểu. VD Thử việc 0, Cấp 1-3 = 1
  promoteMinAvgRevenue Float              @default(0)
  promoteMinTransform  Int                @default(0)
  // Đề lý thuyết riêng của cấp này: số câu bốc ra và điểm đạt (%). Bỏ trống =
  // dùng số chung trong ExamConfig. Có riêng vì đề của cấp cao khó hơn hẳn thì
  // không có lý gì phải chung một ngưỡng đạt với đề Thử việc.
  examNumQuestions     Int?
  examPassingScore     Int?
  // Đề của cấp này thuộc dạng nào: trắc nghiệm phẳng, hay nhiều vòng chơi.
  // Đổi dạng là đổi hẳn trang làm bài — xem enum ExamFormat.
  examFormat           ExamFormat         @default(FLAT)
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  phaseAccess        PTLevelPhaseAccess[]
  users              User[]               @relation("UserPTLevel")
  examQuestions      ExamQuestionLevel[]
  examRounds         ExamRound[]
  examAttempts       ExamAttempt[]
  examSessions       ExamSession[]
  examConfigsForFM   ExamConfig[]         @relation("ExamConfigFMLevel")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("pt_levels")
}

model PTLevelPhaseAccess {
  id        String       @id @default(cuid())
  levelId   String
  level     PTLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  phaseId   String
  phase     WorkoutPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  hasAccess Boolean      @default(true)

  @@unique([levelId, phaseId])
  @@map("pt_level_phase_access")
}

model SystemConfig {
  id                String   @id
  enableLevelSystem Boolean  @default(true)
  // Minimum minutes between check-in and signature for a session to count.
  minSessionMinutes Int      @default(30)
  // Ngưỡng % điểm để ĐẠT bài kiểm tra thực hành (rubric FM chấm).
  practicalPassPercent Int   @default(70)
  // Số ngày giữ dữ liệu trong Thùng rác trước khi tự động xóa vĩnh viễn.
  // 0 = giữ mãi (không tự dọn). Admin chỉnh ngay trong mục Thùng rác.
  trashRetentionDays Int    @default(30)
  updatedAt         DateTime @updatedAt

  @@map("system_config")
}

// ── Bài kiểm tra thực hành (rubric do FM/Admin chấm) ──────────────────────────
model PracticalAssessment {
  id             String   @id @default(cuid())
  ptId           String
  assessorId     String
  levelName      String?  // cấp độ của PT tại thời điểm chấm (lưu vết)
  exercisesCount Int      @default(6)
  scores         String   @db.Text // JSON các tiêu chí cố định: { [code]: 1|3|5 }
  exercises      String   @db.Text // JSON các bài tập: [{ name, scores: { [code]: 1|3|5 } }]
  totalScore     Int
  maxScore       Int
  passed         Boolean
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  pt       User @relation("PTPracticalAssessments", fields: [ptId], references: [id], onDelete: Cascade)
  assessor User @relation("AssessorPracticals", fields: [assessorId], references: [id])

  @@index([ptId])
  @@map("practical_assessments")
}

// ── Substitute Teaching ───────────────────────────────────────────────────────

enum SubType {
  SHORT_TERM
  LONG_TERM
}

enum SubStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model SubstituteRequest {
  id            String    @id @default(cuid())
  clientId      String
  requestedById String
  substituteId  String
  type          SubType
  startDate     DateTime  @default(now())
  endDate       DateTime?
  durationDays  Int?
  status        SubStatus @default(PENDING)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequesterSub", fields: [requestedById], references: [id])
  substitute  User   @relation("SubstituteSub", fields: [substituteId], references: [id])

  @@map("substitute_requests")
}

// ── Hướng dẫn sử dụng ────────────────────────────────────────────────────────

model UserGuide {
  id         String   @id @default(cuid())
  title      String
  roleGroup  String   @default("PT")
  category   String
  youtubeUrl String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_guides")
}

// ── Cơ sở dữ liệu thực phẩm (thay thế USDA) ────────────────────────────────

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  weight_g  Float    @default(100)
  category  String?
  meal_type String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("foods")
}

// ── Thùng rác ─────────────────────────────────────────────────────────────
//
// Mọi thao tác xóa dữ liệu của PT / FM / Admin đều chụp lại toàn bộ bản ghi
// (kèm các bảng con bị cascade) vào đây TRƯỚC khi xóa thật. Admin xem lại ở
// mục "Thùng rác", lọc theo loại dữ liệu / ngày xóa, khôi phục lại hoặc dọn
// sạch. Bản ghi quá hạn (SystemConfig.trashRetentionDays) tự bị dọn.
//
// `payload` là ảnh chụp dạng JSON: { "<tên model prisma>": [ ...dòng dữ liệu ] }.
// Khôi phục = ghi lại từng bảng theo đúng thứ tự phụ thuộc, giữ nguyên id cũ
// nên mọi khóa ngoại trỏ tới nhau vẫn khớp. Xem lib/trash.ts.
model TrashItem {
  id            String   @id @default(cuid())
  // Khóa loại dữ liệu, khớp với TRASH_TYPES trong lib/trash.ts (vd "CLIENT").
  entityType    String
  // Id bản ghi gốc — dùng để chặn khôi phục trùng khi bản ghi đã tồn tại lại.
  entityId      String
  // Tên hiển thị trong danh sách thùng rác (vd tên khách hàng).
  label         String
  // Mô tả phụ (vd "Cơ sở Q7 · PT Ngọc Anh").
  summary       String?  @db.Text
  payload       String   @db.Text
  branchId      String?
  branchName    String?
  deletedById   String?
  deletedByName String?
  deletedByRole String?
  deletedAt     DateTime @default(now())

  @@index([entityType])
  @@index([deletedAt])
  @@map("trash_items")
}
