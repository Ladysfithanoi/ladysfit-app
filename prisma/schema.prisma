  id            String    @id @default(cuid())
  clientId      String
  requestedById String
  substituteId  String
  type          SubType
  startDate     DateTime  @default(now())
  endDate       DateTime?
  durationDays  Int?
  status        SubStatus @default(PENDING)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequesterSub", fields: [requestedById], references: [id])
  substitute  User   @relation("SubstituteSub", fields: [substituteId], references: [id])

  @@map("substitute_requests")
}

// ── Hướng dẫn sử dụng ────────────────────────────────────────────────────────

model UserGuide {
  id         String   @id @default(cuid())
  title      String
  roleGroup  String   @default("PT")
  category   String
  youtubeUrl String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_guides")
}

// ── Cơ sở dữ liệu thực phẩm (thay thế USDA) ────────────────────────────────

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  weight_g  Float    @default(100)
  category  String?
  meal_type String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("foods")
}
