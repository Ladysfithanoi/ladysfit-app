generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users           User[]
  clients         Client[]
  consultations   Consultation[]
  fmAssignments   FMBranchAssignment[]
  complaints      Complaint[]
  salesLeads      SalesLead[]
  monthlyTargets  MonthlyTarget[]
  weeklyReports        WeeklyReport[]
  monthlyBranchReports MonthlyBranchReport[]
  salaryConfigs        SalaryConfig[]
  salaryRecords        SalaryRecord[]
  transactions         Transaction[]

  @@map("branches")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  // QUYỀN — quyết định vào được màn nào, sửa được gì. Cố định trong code.
  role            Role      @default(PT)
  // CHỨC VỤ — nhãn nghề nghiệp do Admin tự thêm (lao công, marketing, lễ tân…).
  // Tách hẳn khỏi role: chức vụ để gọi tên và xếp nhóm, KHÔNG cấp quyền gì.
  jobPositionId   String?
  branchId        String?
  freeUpgradedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dateOfBirth           DateTime?
  ptLevelId             String?
  deletedAt             DateTime?
  ptLevel               PTLevel?             @relation("UserPTLevel", fields: [ptLevelId], references: [id])
  jobPosition           JobPosition?         @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  branch                Branch?              @relation(fields: [branchId], references: [id])
  accounts              Account[]
  sessions              Session[]
  clients               Client[]
  consultations         Consultation[]
  managedBranches       FMBranchAssignment[]
  workoutPrograms       WorkoutProgram[]
  workoutLogs           WorkoutLog[]
  examAttempts          ExamAttempt[]
  examSessions          ExamSession[]
  examBlocks            ExamBlock[]
  examRequirement       ExamRequiredFM?      @relation("RequiredExamFM")
  upgradeNotifications  UpgradeNotification[]
  mealPlans             MealPlan[]
  ptAlerts              PerformanceAlert[] @relation("PTPerformanceAlerts")
  assignedComplaints    Complaint[]        @relation("FMComplaints")
  assignedLeads         SalesLead[]        @relation("AssignedPTLeads")
  createdLeads          SalesLead[]        @relation("CreatedLeads")
  monthlyTargets        MonthlyTarget[]    @relation("PTMonthlyTargets")
  weeklyReports         WeeklyReport[]        @relation("FMWeeklyReports")
  monthlyBranchReports  MonthlyBranchReport[] @relation("FMMonthlyReports")
  ownedWeeklyReports        WeeklyReport[]        @relation("UserWeeklyReports")
  ownedMonthlyBranchReports MonthlyBranchReport[] @relation("UserMonthlyReports")
  dailyChecklists       DailyChecklist[]      @relation("UserDailyChecklists")
  weeklyMonthlyReports  WeeklyMonthlyReport[] @relation("UserWeeklyMonthlyReports")
  salaryConfigs         SalaryConfig[]        @relation("UserSalaryConfigs")
  salaryRecords         SalaryRecord[]        @relation("UserSalaryRecords")
  ptSessionAdjustments  PTSessionAdjustment[] @relation("PTSessionAdjustments")
  transactions          Transaction[]         @relation("TransactionCreator")
  checklistNotifications  ChecklistNotification[]
  measuredBodyLogs        BodyMeasurementLog[]         @relation("MeasuredByUser")
  measurementNotifications MeasurementNotification[]   @relation("PTMeasurementNotifs")
  ptSessionPhotos         SessionPhoto[]               @relation("PTSessionPhotos")
  kocContracts            KOCContract[]                @relation("PTKOCContracts")
  substituteRequestsMade     SubstituteRequest[]          @relation("RequesterSub")
  substituteRequestsReceived SubstituteRequest[]          @relation("SubstituteSub")
  practicalAssessments       PracticalAssessment[]        @relation("PTPracticalAssessments")
  assessedPracticals         PracticalAssessment[]        @relation("AssessorPracticals")
  leaveDays                  LeaveDay[]                   @relation("UserLeaveDays")
  createdLeaveDays           LeaveDay[]                   @relation("LeaveDayCreator")
  clientAssignments          ClientPTAssignment[]         @relation("PTClientAssignments")
  packageProgressNotifs      PackageProgressNotification[] @relation("FMPackageProgressNotifs")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id               String       @id @default(cuid())
  clientCode       String?      @unique
  fullName         String
  phone            String
  email            String?      @unique
  password         String?
  passwordSetAt    DateTime?
  dateOfBirth      DateTime?
  initialWeight    Float
  currentWeight    Float
  targetWeight     Float
  height           Float
  initialWaist     Float?
  initialHip       Float?
  healthConditions String?      @db.Text
  injuries         String?      @db.Text
  targetDate       DateTime?
  goalNote         String?      @db.Text
  myPlateImageUrl  String?      @db.Text
  myPlateNote      String?
  avatarUrl        String?      @db.Text
  assignedPTId     String
  branchId         String
  dietPhase        String       @default("Giai đoạn 1")
  status           ClientStatus @default(ACTIVE)
  hasTransformed   Boolean      @default(false)
  // Number of registered contracts (lộ trình) = count of package_enrollments.
  // Kept in sync whenever enrollments are added/removed; used for churn statistics.
  contractCount    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedPT    User           @relation(fields: [assignedPTId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  weightLogs          WeightLog[]
  activityLogs        ActivityLog[]
  consultations       Consultation[]
  packageEnrollments  PackageEnrollment[]
  workoutPrograms     WorkoutProgram[]
  workoutLogs         WorkoutLog[]
  mealPlans             MealPlan[]
  foodScanLogs          FoodScanLog[]
  performanceAlerts     PerformanceAlert[]
  workoutNotifications  WorkoutNotification[]
  complaints                   Complaint[]
  bodyMeasurementLogs          BodyMeasurementLog[]
  measurementNotifications     MeasurementNotification[]
  sessionPhotos                SessionPhoto[]              @relation("ClientSessionPhotos")
  kocContracts                 KOCContract[]
  substituteRequests           SubstituteRequest[]
  ptAssignments                ClientPTAssignment[]
  packageProgressNotifs        PackageProgressNotification[]

  @@map("clients")
}

// Nhật ký "khách thuộc về ai, từ lúc nào" — mỗi dòng mở một CHẶNG phụ trách,
// chặng kết thúc khi có dòng kế tiếp. Ghi ở cả 3 lối đổi người: tạo khách,
// sửa hồ sơ (đổi nhân sự phụ trách) và chuyển giao dài hạn.
//
// Có bảng này thì transform mới quy được về đúng người: khách chuyển từ PT cũ
// sang PT mới, mốc transform rơi vào chặng nào thì người của chặng đó được ghi
// công — người nhận không "thừa hưởng" kết quả có sẵn của khách. Xem
// lib/transform-credit.ts.
model ClientPTAssignment {
  id        String   @id @default(cuid())
  clientId  String
  ptId      String
  startedAt DateTime @default(now())
  // Vì sao đổi: CREATED (tạo khách) · EDITED (sửa hồ sơ) · TRANSFERRED (chuyển
  // giao dài hạn) · BACKFILL (dựng lại từ dữ liệu cũ khi thêm bảng này)
  reason    String   @default("CREATED")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt     User   @relation("PTClientAssignments", fields: [ptId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@map("client_pt_assignments")
}

model Consultation {
  id                String             @id @default(cuid())
  status            ConsultationStatus @default(DRAFT)
  currentStep       Int                @default(1)
  createdById       String
  branchId          String
  convertedClientId String?
  workoutDesignJson String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdBy       User                    @relation(fields: [createdById], references: [id])
  branch          Branch                  @relation(fields: [branchId], references: [id])
  convertedClient Client?                 @relation(fields: [convertedClientId], references: [id])
  info            ConsultationInfo?
  assessment      ConsultationAssessment?
  packages        ConsultationPackage[]
  workoutPrograms WorkoutProgram[]
  mealPlans       MealPlan[]
  salesLead       SalesLead?

  @@map("consultations")
}

model ConsultationInfo {
  id             String   @id @default(cuid())
  consultationId String   @unique
  fullName       String   @default("")
  phone          String   @default("")
  address        String?
  dateOfBirth    DateTime?
  email          String?
  consultDate    DateTime @default(now())
  knowLDFVia     String?
  referralSource String?
  familyStatus   String?
  height         Float    @default(0)
  currentWeight  Float    @default(0)
  targetWeight   Float    @default(0)
  timeToAchieve  String?
  previousAttempts String?
  currentFeeling String?
  whyNow         String?
  familySupport  String?
  motivationLevel Int?
  barriers       String?
  exerciseExperience String?
  currentDiet    String?
  mealsPerDay    Int?
  typicalMeals   String?
  snacking       String?
  diningOut      String?
  foodPreferences String?
  foodAllergies  String?
  workoutsPerWeek Int?
  availableTime  String?
  healthConditions String?
  injuries       String?
  stressLevel    Int?
  sleepQuality   String?
  goalDescription String?
  desiredPackage String?
  budget         String?
  whoPaysBill    String?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_info")
}

model ConsultationAssessment {
  id                  String  @id @default(cuid())
  consultationId      String  @unique
  waist               Float?
  hip                 Float?
  bmi                 Float?
  bmiCategory         String?
  idealWeight         String?
  whr                 Float?
  whrCategory         String?
  recommendedPackages String? @db.Text
  notes               String? @db.Text

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_assessments")
}

model ConsultationPackage {
  id             String  @id @default(cuid())
  consultationId String
  packageName    String
  packageStage   String
  sessions       Int
  durationDays   Int
  price          Float
  discountedPrice Float?
  order          Int
  isConfirmed    Boolean @default(false)
  /// Bậc của gói trên bậc thang 3 giai đoạn (1/2/3) — xem lib/roadmap-phases.ts.
  /// Gói nào ghép vào bậc nào cũng được nên không suy ngược ra từ tên gói được;
  /// null = lộ trình lưu từ trước khi có bậc thang, lúc đó suy tạm theo stage.
  roadmapPhase   Int?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_packages")
}

model ActivityLog {
  id            String   @id @default(cuid())
  clientId      String
  date          DateTime @db.Date
  steps         Int?
  minutesActive Int?
  minutesGym    Int?
  note          String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@map("activity_logs")
}

model WeightLog {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime
  weight    Float
  note      String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("weight_logs")
}

/// Chức vụ nhân sự — danh sách Admin tự quản, không phải sửa code để thêm.
///
/// CỐ Ý KHÔNG phải enum Role. Role là QUYỀN: mỗi giá trị của nó gắn với một bộ
/// màn hình và một bộ thao tác được phép, và mọi kiểm tra quyền trong app đều
/// so theo nó. Cho thêm giá trị mới vào Role lúc chạy nghĩa là sinh ra những
/// người mà không đoạn mã nào biết họ được làm gì — mở đúng chỗ nguy hiểm nhất.
///
/// Chức vụ chỉ là nhãn nghề nghiệp: hiện ở danh sách nhân sự, bảng lương, bộ
/// lọc. Thêm "Lao công" ở đây không cấp thêm quyền nào cho ai.
model JobPosition {
  id        String   @id @default(cuid())
  name      String   @unique
  /// QUYỀN mà chức vụ này cấp. Admin chọn khi tạo chức vụ, rồi lúc thêm nhân sự
  /// chỉ phải chọn MỘT ô — quyền đi theo chức vụ.
  ///
  /// Vẫn là enum cố định: Admin chọn TỪ danh sách có sẵn, không tự đặt ra quyền
  /// mới. Chức vụ thì thêm bao nhiêu cũng được, quyền thì không.
  role      Role     @default(STAFF)
  color     String   @default("#6b7280")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users User[]

  @@map("job_positions")
}

enum Role {
  ADMIN
  FM
  CEO_FITPARTNER
  COO
  PT
  /// Nhân sự không dùng phần mềm quản lý (lao công, marketing, lễ tân…).
  /// Đăng nhập chỉ để xem lương của chính mình; mọi màn quản lý đều từ chối
  /// vì không danh sách cho phép nào có STAFF.
  STAFF
}

model FMBranchAssignment {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("fm_branch_assignments")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  RESERVED
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  RESOLVED
}

model Complaint {
  id           String          @id @default(cuid())
  clientId     String
  branchId     String
  assignedFMId String?
  category     String
  content      String          @db.Text
  status       ComplaintStatus @default(PENDING)
  fmNote       String?         @db.Text
  isReadByFM   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branch     Branch  @relation(fields: [branchId], references: [id])
  assignedFM User?   @relation("FMComplaints", fields: [assignedFMId], references: [id])

  @@map("complaints")
}

model PackageEnrollment {
  id           String                  @id @default(cuid())
  clientId     String
  contractCode String?
  packageName  String
  packageStage String
  sessions     Int
  sessionsUsed   Int                     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int
  reservedDays   Int                     @default(0)
  extensionDays  Int                     @default(0)
  price          Float
  contractType   ContractType            @default(NORMAL)
  status         PackageEnrollmentStatus @default(ACTIVE)
  notes          String?                 @db.Text
  createdAt      DateTime                @default(now())

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutPrograms WorkoutProgram[]
  sessionPhotos   SessionPhoto[]
  kocContract     KOCContract?
  ptSessionAdjustments PTSessionAdjustment[]
  progressNotifications PackageProgressNotification[]

  @@map("package_enrollments")
}

// Admin/FM chỉnh tay "Số buổi PT" của một lộ trình.
//
// "Số buổi PT" tự đếm từ workout_logs (buổi đã check-out có chữ ký kèm nhật ký
// buổi tập). Khi con số tự đếm sai — buổi dạy thật nhưng ký hỏng, dữ liệu cũ —
// Admin/FM sửa lại tổng số buổi của lộ trình ở hồ sơ khách; phần CHÊNH LỆCH được
// ghi vào đây theo THÁNG SỬA và cộng vào lương tháng đó.
//
// Lưu theo (lộ trình · tháng) nên sửa nhiều lần qua nhiều tháng vẫn cộng dồn
// đúng, và tiền chỉ rơi vào đúng tháng đã ghi nhận.
model PTSessionAdjustment {
  id           String   @id @default(cuid())
  enrollmentId String
  // PT được ghi công phần chênh lệch — PT phụ trách khách lúc sửa.
  ptId         String
  month        Int
  year         Int
  // Số buổi cộng thêm, có thể âm khi trừ bớt.
  delta        Int
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  pt         User              @relation("PTSessionAdjustments", fields: [ptId], references: [id])

  @@unique([enrollmentId, month, year])
  @@index([ptId, month, year])
  @@map("pt_session_adjustments")
}

enum PackageEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  EXPIRED
}

enum ContractType {
  NORMAL
  KOC
  KOL
}

enum KOCContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model KOCContract {
  id                    String            @id @default(cuid())
  enrollmentId          String            @unique
  clientId              String
  ptId                  String
  startWeight           Float
  endWeight             Float?
  startWeightConfirmed  Boolean           @default(false)
  endWeightConfirmed    Boolean           @default(false)
  contractDate          DateTime          @default(now())
  endDate               DateTime
  status                KOCContractStatus @default(ACTIVE)
  totalSessions         Int               @default(0)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  enrollment PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt         User              @relation("PTKOCContracts", fields: [ptId], references: [id])

  @@map("koc_contracts")
}

enum ConsultationStatus {
  DRAFT
  COMPLETED
}

enum WorkoutProgramStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

model WorkoutExercise {
  id       String @id @default(cuid())
  phase    String
  type     String
  movement String
  name     String

  @@index([phase, type, movement])
  @@map("workout_exercises")
}

model WorkoutMovementTemplate {
  id          String   @id @default(cuid())
  phaseKey    String
  sessionType String
  movement    String
  createdAt   DateTime @default(now())

  @@unique([phaseKey, sessionType, movement])
  @@map("workout_movement_templates")
}

// Lịch tập mẫu do admin thiết lập: bài tập mặc định cho mỗi chuyển động của từng
// loại buổi trong mỗi giai đoạn. PT dùng nút "Copy từ lịch mẫu" để điền nhanh.
model WorkoutScheduleTemplate {
  id          String   @id @default(cuid())
  phaseKey    String // = WorkoutPhase.name (khoá SESSION_TYPES), vd "Giai đoạn 2: Skinny Fat"
  sessionType String // vd "Full 1"
  movement    String // mã chuyển động (slot code), vd "A1. Squat"
  exercise    String // tên bài tập mặc định
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([phaseKey, sessionType, movement])
  @@map("workout_schedule_templates")
}

model WorkoutPhase {
  id           String               @id @default(cuid())
  name         String
  order        Int
  isActive     Boolean              @default(true)
  sessionTypes String[]             @default([])
  defaultReps  String               @default("15-20")
  templateKey  String               @default("")
  programs     WorkoutProgram[]
  levelAccess  PTLevelPhaseAccess[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("workout_phases")
}

model WorkoutProgram {
  id                  String               @id @default(cuid())
  clientId            String?
  consultationId      String?
  packageEnrollmentId String?
  phase               String
  phaseId             String?
  workoutType         String?
  sessionsPerWeek     Int
  currentWeek         Int                  @default(1)
  notes               String?              @db.Text
  status              WorkoutProgramStatus @default(ACTIVE)
  manualPhaseOverride Boolean              @default(false)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation      Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  packageEnrollment PackageEnrollment? @relation(fields: [packageEnrollmentId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  workoutPhase      WorkoutPhase?      @relation(fields: [phaseId], references: [id])
  sessions          WorkoutSession[]
  weeks             WorkoutWeek[]
  workoutLogs       WorkoutLog[]

  @@map("workout_programs")
}

model WorkoutWeek {
  id         String   @id @default(cuid())
  programId  String
  weekNumber Int
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  program     WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]
  workoutLogs WorkoutLog[]

  @@map("workout_weeks")
}

model WorkoutSession {
  id          String  @id @default(cuid())
  programId   String
  weekId      String?
  sessionName String
  order       Int

  program     WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  week        WorkoutWeek?      @relation(fields: [weekId], references: [id], onDelete: SetNull)
  movements   WorkoutMovement[]
  workoutLogs WorkoutLog[]

  @@map("workout_sessions")
}

model ExamQuestion {
  id        String   @id @default(cuid())
  question  String   @db.Text
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  // Minh hoạ cho câu hỏi — có thể có ảnh, có video, có cả hai, hoặc không có
  // gì (câu hỏi chỉ có chữ như trước). imageUrl là link ảnh đã tải lên Storage;
  // videoUrl thường là link YouTube, xem lib/exam-media.ts.
  imageUrl  String?  @db.Text
  videoUrl  String?  @db.Text

  levels ExamQuestionLevel[]

  @@map("exam_questions")
}

// ── Đề thử thách 7 đại tội (Cấp 2 lên Cấp 3) ─────────────────────────────────
//
// Đề của cấp thấp là trắc nghiệm phẳng: bốc N câu A/B/C/D, đúng bao nhiêu tính
// bấy nhiêu. Lên tới cửa Cấp 3 thì thứ cần đo không còn là trí nhớ mà là phán
// đoán, nên đề đổi hẳn dạng: một lượt thi gồm nhiều VÒNG, mỗi vòng một lối chơi
// riêng gắn với một đại tội — và lối chơi chính là bài kiểm tra.
//
//   Phàm ăn (MEAL) — dựng khay ăn cho một hồ sơ khách sao cho chạm đúng chỉ tiêu
//   Sa ngã  (SORT) — phân loại tình huống khách vào đúng vùng ranh giới nghề
//
// Cả hai đều máy chấm được — bắt buộc, vì đây là cổng thăng cấp chứ không phải
// trò chơi. Điểm cuối cùng vẫn ghi vào ExamAttempt như đề phẳng để bộ máy xét
// thăng cấp không phải biết đề dạng nào (xem lib/exam-trial.ts, exam-grading.ts).
enum ExamFormat {
  /// Trắc nghiệm phẳng — dạng cũ, dùng cho các cấp thấp.
  FLAT
  /// Nhiều vòng, mỗi vòng một lối chơi.
  TRIAL
}

/// LỐI CHƠI của một vòng — cơ chế, KHÔNG phải tên đại tội.
///
/// Hai thứ này khác nhau và phải để riêng: một đại tội có thể dùng lối chơi
/// nào cũng được, và cùng một lối chơi có thể phục vụ nhiều đại tội. Trộn làm
/// một là dropdown chọn lối chơi lại đi hiện tên tội, đổi tên vòng thì nó
/// không đổi theo — đúng một lần đã gây nhầm.
enum ExamRoundType {
  /// Dựng khay ăn chạm đúng chỉ tiêu calo/đạm/béo/đường.
  MEAL
  /// Xếp thẻ tình huống vào đúng một trong ba vùng.
  SORT
}

/// Bảy đại tội — danh sách đóng, đúng bản kinh điển. Mỗi vòng gắn một tội.
enum ExamSin {
  /// Kiêu ngạo → chuyên môn kỹ thuật, form động tác
  PRIDE
  /// Tham lam → doanh số & đạo đức bán gói
  GREED
  /// Dục vọng → ranh giới nghề nghiệp
  LUST
  /// Ghen tị → sale
  ENVY
  /// Phàm ăn → dinh dưỡng
  GLUTTONY
  /// Phẫn nộ → xử lý khiếu nại, xung đột
  WRATH
  /// Lười biếng → giữ khách, chống bỏ tập
  SLOTH
}

/// Ba vùng ranh giới của vòng phân loại tình huống, xếp theo mức cứng rắn tăng dần —
/// thứ tự này có ý nghĩa chấm điểm: lệch 1 bậc còn nửa điểm, lệch 2 bậc mất hết.
enum ExamSortZone {
  ACCEPT
  CAUTION
  REFUSE
}

model ExamRound {
  id          String        @id @default(cuid())
  levelId     String
  /// Lối chơi (cơ chế). Xem enum ExamRoundType.
  type        ExamRoundType
  /// Đại tội của vòng. Tách hẳn khỏi lối chơi và khỏi tên hiển thị.
  sin         ExamSin?
  /// Tên vòng hiện cho thí sinh — sửa tự do, mặc định lấy theo tên đại tội.
  name        String
  /// Luật chơi / lời dẫn hiện đầu vòng.
  intro       String?       @db.Text
  order       Int           @default(0)
  /// Điểm tối đa của vòng, chia đều cho các thẻ / hồ sơ trong vòng.
  maxPoints   Int           @default(100)
  /// Đạt vòng khi được ít nhất bấy nhiêu % điểm của vòng.
  passPercent Int           @default(60)
  /// Trượt vòng bị trừ thẳng bấy nhiêu điểm vào tổng — trượt một vòng không
  /// đánh rớt cả kỳ, nhưng phải trả giá.
  failPenalty Int           @default(20)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  level      PTLevel           @relation(fields: [levelId], references: [id], onDelete: Cascade)
  mealBriefs ExamMealBrief[]
  sortCards  ExamSortCard[]
  results    ExamRoundResult[]

  @@index([levelId, order])
  @@map("exam_rounds")
}

/// Một hồ sơ khách của vòng Phàm ăn: thí sinh phải dựng khay ăn chạm đúng chỉ
/// tiêu. Chỉ tiêu nào bỏ trống thì vòng không chấm chỉ tiêu đó.
/// Nhóm hồ sơ khay ăn — để mỗi lượt thi luôn bốc đủ ba dạng, không rơi vào
/// cảnh cả ba khách đều muốn giảm cân. Xem TRIAL_BRIEF_MIX.
enum ExamMealKind {
  /// Khách giảm cân — dạng phổ biến nhất.
  CUT
  /// Khách cần TĂNG calo: gầy muốn lên cân, hoặc đang xây cơ.
  BULK
  /// Có ràng buộc bắt buộc: dị ứng, bệnh nền, thai kỳ, ăn chay.
  SPECIAL
}

model ExamMealBrief {
  id            String  @id @default(cuid())
  roundId       String
  order         Int     @default(0)
  /// Nhóm hồ sơ. Rỗng = coi như CUT.
  kind          ExamMealKind?
  /// Mô tả khách: tuổi, cân nặng, mục tiêu, thói quen…
  clientProfile String  @db.Text
  targetCalories Int?
  targetProtein  Int?
  targetFat      Int?
  targetCarbs    Int?
  /// Sai số cho phép quanh mỗi chỉ tiêu (%).
  tolerancePercent Int  @default(10)
  /// Món khách KHÔNG được ăn (dị ứng, bệnh lý) — JSON mảng tên món. Dùng phải
  /// một món trong đây là hỏng cả hồ sơ, không có điểm an ủi: dị ứng không
  /// phải chuyện thương lượng.
  bannedFoods   String? @db.Text
  /// Giảng giải hiện sau khi chấm.
  explanation   String? @db.Text

  round ExamRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, order])
  @@map("exam_meal_briefs")
}

/// Một thẻ tình huống của vòng Sa ngã.
model ExamSortCard {
  id          String       @id @default(cuid())
  roundId     String
  order       Int          @default(0)
  text        String       @db.Text
  correctZone ExamSortZone
  explanation String?      @db.Text

  round ExamRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, order])
  @@map("exam_sort_cards")
}

/// Kết quả từng vòng của một lượt thi — để Admin soi được người này mạnh yếu
/// vòng nào, chứ nhìn mỗi tổng điểm thì không biết họ hỏng ở đâu.
model ExamRoundResult {
  id        String @id @default(cuid())
  attemptId String
  roundId   String
  /// Điểm đạt được và điểm tối đa của vòng (chép lại, vì vòng có thể bị sửa sau).
  points    Int
  maxPoints Int
  passed    Boolean
  /// Điểm bị trừ vì trượt vòng này (0 nếu đạt).
  penalty   Int    @default(0)
  /// Bài làm chi tiết của vòng — JSON, dạng tuỳ theo loại vòng.
  detail    String @db.Text
  /// Nghiêng về trụ nào trong vòng này: SEVERITY | MERCY | BALANCE.
  pillar    String?

  attempt ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  round   ExamRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([attemptId, roundId])
  @@map("exam_round_results")
}

// Câu hỏi này nằm trong đề của những CẤP nào.
//
// "Đề Cấp N" = bộ câu hỏi mà người ĐANG Ở Cấp N phải làm để được xét lên cấp
// kế tiếp — cùng cách hiểu với promoteMinAvgRevenue/promoteMinTransform của
// PTLevel, đều là điều kiện để RỜI cấp đó.
//
// Nhiều-nhiều chứ không phải một khoá ngoại, vì một câu hoàn toàn có thể dùng
// chung cho vài cấp: 150 câu gốc của phòng tập đang phục vụ cả "Thử việc" lẫn
// "Cấp 1". Gắn thêm/bớt cấp không phải chép lại câu hỏi.
model ExamQuestionLevel {
  id         String @id @default(cuid())
  questionId String
  levelId    String

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  level    PTLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([questionId, levelId])
  @@index([levelId])
  @@map("exam_question_levels")
}

model ExamConfig {
  id               String   @id @default(cuid())
  numQuestions     Int      @default(10)
  passingScore     Int      @default(80)
  shuffleQuestions Boolean  @default(true)
  // Lịch thi: tắt => không ai vào thi được. Bật => chỉ thi được đúng ngày, trong khung giờ.
  // Ngày/giờ lưu dạng chuỗi theo giờ VN (UTC+7) để không lệch múi giờ server.
  scheduleEnabled  Boolean  @default(false)
  examDate         String?
  examStartTime    String   @default("00:00")
  examEndTime      String   @default("23:59")
  // Thời lượng mỗi người được làm bài, tính bằng phút. Khác với khung giờ ở
  // trên: khung giờ là lúc phòng thi MỞ CỬA, còn đây là thời gian mỗi thí sinh
  // được ngồi làm kể từ lúc mở đề. 0 = không giới hạn.
  durationMinutes  Int      @default(0)
  // Phạt rời khỏi trang thi: mỗi lần thí sinh chuyển tab / thu nhỏ trình duyệt
  // để đi đọc tài liệu thì bị trừ bấy nhiêu phút vào thời lượng làm bài của
  // chính họ. 0 = tắt (chỉ ghi nhận số lần rời trang, không trừ giờ). Chỉ có
  // tác dụng khi durationMinutes > 0, vì không có đồng hồ thì không trừ được gì.
  focusPenaltyMinutes Int   @default(30)
  // Trọng số (%) 3 tiêu chí của bảng xếp hạng — tổng phải bằng 100
  rankWeightExam      Int   @default(30)
  rankWeightRevenue   Int   @default(40)
  rankWeightTransform Int   @default(30)
  // FM bắt buộc thi làm đề của cấp nào. FM không có cấp độ PT nên không tự suy
  // ra được — Admin chọn trong tab Lịch thi. Bỏ trống = FM chưa vào thi được.
  fmLevelId        String?
  updatedAt        DateTime @updatedAt

  fmLevel PTLevel? @relation("ExamConfigFMLevel", fields: [fmLevelId], references: [id], onDelete: SetNull)

  @@map("exam_config")
}

model ExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  total     Int
  passed    Boolean
  answers   String   @db.Text
  createdAt DateTime @default(now())
  // Số lần thí sinh rời khỏi trang thi trong lượt này — chép lại từ ExamSession
  // lúc nộp bài để Admin còn xem được sau khi kỳ thi đã đóng.
  violations Int      @default(0)
  // Bài này là ĐỀ CỦA CẤP NÀO. Thiếu trường này thì không phân biệt được người
  // đang ở Cấp 2 đã thi đề Cấp 2 hay mới chỉ đậu đề Cấp 1 từ đợt thăng cấp
  // trước — xem lib/pt-promotion.ts, điều kiện lý thuyết soát theo đúng cấp.
  levelId    String?
  /// Tội thí sinh đã khai ở lượt thi này (đề nhiều vòng). Lưu lại để về sau còn
  /// biết họ đã dám nhận mình yếu ở đâu, và có vượt qua được không.
  declaredSin ExamSin?

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  level        PTLevel?          @relation(fields: [levelId], references: [id], onDelete: SetNull)
  roundResults ExamRoundResult[]

  @@index([userId, levelId])
  @@map("exam_attempts")
}

// Một LƯỢT THI = một người × một kỳ thi (khoá theo ngày thi trong ExamConfig).
//
// Sinh ra để làm ba việc mà chỉ nhìn vào exam_attempts thì không làm được:
//
//  1. Mỗi người chỉ thi MỘT lần một kỳ. Nộp xong là submittedAt có giá trị,
//     mở lại đề là bị chặn. Admin muốn cho ai thi lại thì xoá bài của họ ở tab
//     Kết quả thi — xoá bài là xoá luôn lượt, khoá tự mở.
//  2. Tải lại trang không đổi được đề, cũng không xin thêm được giờ: đề đã bốc
//     nằm trong questionIds, mốc hết giờ tính từ startedAt nên F5 bao nhiêu lần
//     cũng ra đúng đề cũ và đúng thời gian còn lại.
//  3. Ghi phạt rời trang. Client báo về mỗi lần thí sinh chuyển tab, server
//     cộng vào penaltyMinutes — trừ ở server nên sửa giờ máy hay chặn JS cũng
//     không gỡ được. Xem app/api/exam/violation.
model ExamSession {
  id              String    @id @default(cuid())
  userId          String
  /// Khoá kỳ thi — chính là examDate ("YYYY-MM-DD") lúc mở đề.
  examKey         String
  /// JSON mảng id câu hỏi đã bốc, giữ đúng thứ tự hiển thị.
  questionIds     String    @db.Text
  /// Đáp án đang làm dở, tự lưu trong lúc thi: JSON { idCâuHỏi: "A"|"B"|"C"|"D" }.
  /// Nhờ nó mà mất mạng, sập trình duyệt, hết pin hay hết giờ không nộp kịp thì
  /// bài vẫn chấm lại được — xem app/api/exam/autosave và lib/exam-grading.
  answers         String?   @db.Text
  /// Thời lượng (phút) chốt lúc mở đề. 0 = không giới hạn.
  durationMinutes Int       @default(0)
  startedAt       DateTime  @default(now())
  /// Tổng số phút đã bị trừ vì rời trang.
  penaltyMinutes  Int       @default(0)
  /// Số lần rời trang.
  violations      Int       @default(0)
  lastViolationAt DateTime?
  /// Có giá trị = đã nộp bài, không vào thi lại được nữa.
  submittedAt     DateTime?
  attemptId       String?
  /// Đề của cấp nào — chốt lúc mở đề. Bài hết giờ được chấm lại sau đó phải
  /// dùng đúng điểm đạt của cấp này, dù lúc ấy người thi đã đổi cấp.
  levelId         String?
  /// Bài làm dở của đề nhiều vòng (JSON). Tách khỏi answers vì answers là bản
  /// đồ phẳng { idCâuHỏi: "A" } của đề trắc nghiệm, không chứa nổi bài của vòng chơi.
  trialState      String?   @db.Text
  /// Bộ THẺ / HỒ SƠ đã bốc cho lượt này (JSON mảng id). Mỗi vòng có ngân hàng
  /// riêng — 50 thẻ, mỗi lượt phát 13 — nên phải ghi lại đã phát những thẻ nào:
  /// F5 không được bốc lại, và lúc chấm phải chấm đúng bộ đã cho người ta thấy.
  /// Rỗng = phát cả vòng (lối cũ, trước khi có ngân hàng thẻ).
  trialItemIds    String?   @db.Text
  /// TỘI THÍ SINH TỰ KHAI trước khi được xem đề — vòng của tội đó khó hơn, điểm
  /// nhân đôi, và bắt buộc phải qua. Khai xong là chốt, không đổi lại được: cho
  /// đổi thì người ta xem đề rồi mới khai, mất sạch ý nghĩa của việc khai.
  declaredSin     ExamSin?

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level PTLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  @@unique([userId, examKey])
  @@index([examKey])
  @@map("exam_sessions")
}

// FM bắt buộc thi — Admin chỉ định trong tab Lịch thi. FM có tên ở đây vào thi
// được như HLV và Admin xem được điểm, nhưng đó chỉ để nắm trình độ: thi trượt
// KHÔNG bị hạ cấp, không sinh thông báo, không đụng tới xếp hạng hay cấp bậc
// của họ. Bỏ tên khỏi danh sách là hết bắt buộc.
model ExamRequiredFM {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation("RequiredExamFM", fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_required_fms")
}

// Khoá quyền vào thi của một người, cho ĐÚNG một kỳ thi.
//
// Có dòng ở đây = người đó không mở được đề, dù là HLV hay FM bắt buộc thi.
// Admin bật/tắt ngay trong tab Lịch thi. Khoá theo từng kỳ (examKey là ngày
// thi) nên đổi sang kỳ mới là mọi khoá cũ hết hiệu lực — không ai bị khoá
// vĩnh viễn vì một lần Admin quên gỡ.
model ExamBlock {
  id        String   @id @default(cuid())
  userId    String
  examKey   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examKey])
  @@index([examKey])
  @@map("exam_blocks")
}

model UpgradeNotification {
  id        String    @id @default(cuid())
  userId    String
  userName  String
  passed    Boolean
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upgrade_notifications")
}

model WorkoutMovement {
  id               String @id @default(cuid())
  sessionId        String
  movementCode     String
  movementName     String
  selectedExercise String
  sets             Int
  reps             String
  order            Int
  // Set 1 nhân sự chuẩn bị TRƯỚC khi khách đến (Hồ sơ khách → CT Tập → buổi tập).
  // Đây chính là Set 1 của nhật ký, chỉ khác thời điểm nhập: lúc check-in giá trị
  // này được đổ thẳng vào Set 1 (nên gợi ý tự động không đè lên), và ngược lại sửa
  // Set 1 trong nhật ký thì ghi lại về đây. Xem lib/workout-session.ts.
  plannedLoad      String?
  plannedReps      String?

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setLogs WorkoutSetLog[]

  @@map("workout_movements")
}

// Lifecycle of a workout session, used for the check-in/check-out anti-cheat flow.
// Legacy/manually saved logs default to COMPLETED so existing counts stay intact.
// AWAITING_CONFIRMATION = PT finished, waiting for the client to confirm on their app.
enum WorkoutLogStatus {
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  VOID
}

// How a completed session was confirmed by the client.
// CLIENT_APP = client tapped confirm on their own device (strong, anti-forgery).
// SIGNATURE  = client signed on the PT's device (fallback, weaker — flagged for review).
enum WorkoutConfirmMethod {
  CLIENT_APP
  SIGNATURE
}

model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  programId   String
  weekId      String
  sessionId   String
  sessionDate DateTime @default(now())
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  // ── Check-in / check-out tracking (server-authoritative timestamps) ──
  status             WorkoutLogStatus @default(COMPLETED)
  checkInAt          DateTime?
  checkOutAt         DateTime?
  // First time the PT entered any set data; used to enforce the "interaction
  // within 10 minutes of check-in" rule.
  firstInteractionAt DateTime?
  // Client's hand-drawn signature at CHECK-OUT (proof PT taught → counts for salary).
  signatureUrl       String?          @db.Text
  // Client's hand-drawn signature at CHECK-IN (proof client showed up → deducts package).
  checkInSignatureUrl String?         @db.Text
  // Ảnh PT chụp CÙNG KHÁCH tại thời điểm check-out — bằng chứng buổi tập có thật,
  // chống ký khống. Bắt buộc khi ký check-out, và chỉ chụp trực tiếp bằng camera
  // (giao diện không có ô tải ảnh từ máy). Lưu dạng data URL JPEG đã nén.
  checkOutPhotoUrl    String?         @db.Text
  // Whether this log has already incremented the package's sessionsUsed. Set at
  // check-in (when the client signs in); used to reverse exactly once on delete/void.
  packageCounted     Boolean          @default(false)
  // Which package enrollment this session was charged against (the one whose
  // sessionsUsed was incremented at check-in). Recorded so delete/void reverses
  // the exact same lộ trình even when the client has several active packages.
  packageEnrollmentId String?
  // Client tapped "đồng ý kết thúc buổi sớm" in their own app: lets the PT check
  // out and count the teaching session without the usual min-duration / 6-exercise
  // gates (e.g. khách có việc, chỉ tập được 30' nhưng vẫn đồng ý tính buổi).
  earlyEndApprovedAt DateTime?
  // How/when the client confirmed the session (drives sessionsUsed increment).
  confirmationMethod WorkoutConfirmMethod?
  confirmedAt        DateTime?
  // Reason a session was voided (e.g. no interaction within 10 minutes).
  voidReason         String?

  // ── Đánh giá buổi tập (autoregulation) — PT bắt buộc làm trước khi ký
  // check-out. 3 trục: hiệu suất / cảm giác nỗ lực (RIR) / hồi phục. Từ đó sinh
  // gợi ý điều chỉnh tải cho BUỔI SAU (lưu ở nextSessionSuggestion, hiển thị đầu
  // buổi kế tiếp cùng loại). Xem lib/session-evaluation.ts.
  surveyPerformance     String?
  surveyRirFeel         String?
  surveyRecovery        String?
  nextSessionSuggestion String? @db.Text

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  week      WorkoutWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdById], references: [id])
  setLogs      WorkoutSetLog[]
  notification WorkoutNotification?

  @@map("workout_logs")
}

