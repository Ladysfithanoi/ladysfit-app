generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users           User[]
  clients         Client[]
  consultations   Consultation[]
  fmAssignments   FMBranchAssignment[]
  complaints      Complaint[]
  salesLeads      SalesLead[]
  monthlyTargets  MonthlyTarget[]
  weeklyReports        WeeklyReport[]
  monthlyBranchReports MonthlyBranchReport[]
  salaryConfigs        SalaryConfig[]
  salaryRecords        SalaryRecord[]
  transactions         Transaction[]

  @@map("branches")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(PT)
  branchId        String?
  freeUpgradedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dateOfBirth           DateTime?
  ptLevelId             String?
  deletedAt             DateTime?
  ptLevel               PTLevel?             @relation("UserPTLevel", fields: [ptLevelId], references: [id])

  branch                Branch?              @relation(fields: [branchId], references: [id])
  accounts              Account[]
  sessions              Session[]
  clients               Client[]
  consultations         Consultation[]
  managedBranches       FMBranchAssignment[]
  workoutPrograms       WorkoutProgram[]
  workoutLogs           WorkoutLog[]
  examAttempts          ExamAttempt[]
  upgradeNotifications  UpgradeNotification[]
  mealPlans             MealPlan[]
  ptAlerts              PerformanceAlert[] @relation("PTPerformanceAlerts")
  assignedComplaints    Complaint[]        @relation("FMComplaints")
  assignedLeads         SalesLead[]        @relation("AssignedPTLeads")
  createdLeads          SalesLead[]        @relation("CreatedLeads")
  monthlyTargets        MonthlyTarget[]    @relation("PTMonthlyTargets")
  weeklyReports         WeeklyReport[]        @relation("FMWeeklyReports")
  monthlyBranchReports  MonthlyBranchReport[] @relation("FMMonthlyReports")
  ownedWeeklyReports        WeeklyReport[]        @relation("UserWeeklyReports")
  ownedMonthlyBranchReports MonthlyBranchReport[] @relation("UserMonthlyReports")
  dailyChecklists       DailyChecklist[]      @relation("UserDailyChecklists")
  weeklyMonthlyReports  WeeklyMonthlyReport[] @relation("UserWeeklyMonthlyReports")
  salaryConfigs         SalaryConfig[]        @relation("UserSalaryConfigs")
  salaryRecords         SalaryRecord[]        @relation("UserSalaryRecords")
  ptSessionAdjustments  PTSessionAdjustment[] @relation("PTSessionAdjustments")
  transactions          Transaction[]         @relation("TransactionCreator")
  checklistNotifications  ChecklistNotification[]
  measuredBodyLogs        BodyMeasurementLog[]         @relation("MeasuredByUser")
  measurementNotifications MeasurementNotification[]   @relation("PTMeasurementNotifs")
  ptSessionPhotos         SessionPhoto[]               @relation("PTSessionPhotos")
  kocContracts            KOCContract[]                @relation("PTKOCContracts")
  substituteRequestsMade     SubstituteRequest[]          @relation("RequesterSub")
  substituteRequestsReceived SubstituteRequest[]          @relation("SubstituteSub")
  practicalAssessments       PracticalAssessment[]        @relation("PTPracticalAssessments")
  assessedPracticals         PracticalAssessment[]        @relation("AssessorPracticals")
  leaveDays                  LeaveDay[]                   @relation("UserLeaveDays")
  createdLeaveDays           LeaveDay[]                   @relation("LeaveDayCreator")
  clientAssignments          ClientPTAssignment[]         @relation("PTClientAssignments")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id               String       @id @default(cuid())
  clientCode       String?      @unique
  fullName         String
  phone            String
  email            String?      @unique
  password         String?
  passwordSetAt    DateTime?
  dateOfBirth      DateTime?
  initialWeight    Float
  currentWeight    Float
  targetWeight     Float
  height           Float
  initialWaist     Float?
  initialHip       Float?
  healthConditions String?      @db.Text
  injuries         String?      @db.Text
  targetDate       DateTime?
  goalNote         String?      @db.Text
  myPlateImageUrl  String?      @db.Text
  myPlateNote      String?
  avatarUrl        String?      @db.Text
  assignedPTId     String
  branchId         String
  dietPhase        String       @default("Giai đoạn 1")
  status           ClientStatus @default(ACTIVE)
  hasTransformed   Boolean      @default(false)
  // Number of registered contracts (lộ trình) = count of package_enrollments.
  // Kept in sync whenever enrollments are added/removed; used for churn statistics.
  contractCount    Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedPT    User           @relation(fields: [assignedPTId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  weightLogs          WeightLog[]
  activityLogs        ActivityLog[]
  consultations       Consultation[]
  packageEnrollments  PackageEnrollment[]
  workoutPrograms     WorkoutProgram[]
  workoutLogs         WorkoutLog[]
  mealPlans             MealPlan[]
  foodScanLogs          FoodScanLog[]
  performanceAlerts     PerformanceAlert[]
  workoutNotifications  WorkoutNotification[]
  complaints                   Complaint[]
  bodyMeasurementLogs          BodyMeasurementLog[]
  measurementNotifications     MeasurementNotification[]
  sessionPhotos                SessionPhoto[]              @relation("ClientSessionPhotos")
  kocContracts                 KOCContract[]
  substituteRequests           SubstituteRequest[]
  ptAssignments                ClientPTAssignment[]

  @@map("clients")
}

// Nhật ký "khách thuộc về ai, từ lúc nào" — mỗi dòng mở một CHẶNG phụ trách,
// chặng kết thúc khi có dòng kế tiếp. Ghi ở cả 3 lối đổi người: tạo khách,
// sửa hồ sơ (đổi nhân sự phụ trách) và chuyển giao dài hạn.
//
// Có bảng này thì transform mới quy được về đúng người: khách chuyển từ PT cũ
// sang PT mới, mốc transform rơi vào chặng nào thì người của chặng đó được ghi
// công — người nhận không "thừa hưởng" kết quả có sẵn của khách. Xem
// lib/transform-credit.ts.
model ClientPTAssignment {
  id        String   @id @default(cuid())
  clientId  String
  ptId      String
  startedAt DateTime @default(now())
  // Vì sao đổi: CREATED (tạo khách) · EDITED (sửa hồ sơ) · TRANSFERRED (chuyển
  // giao dài hạn) · BACKFILL (dựng lại từ dữ liệu cũ khi thêm bảng này)
  reason    String   @default("CREATED")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt     User   @relation("PTClientAssignments", fields: [ptId], references: [id], onDelete: Cascade)

  @@index([clientId, startedAt])
  @@map("client_pt_assignments")
}

model Consultation {
  id                String             @id @default(cuid())
  status            ConsultationStatus @default(DRAFT)
  currentStep       Int                @default(1)
  createdById       String
  branchId          String
  convertedClientId String?
  workoutDesignJson String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdBy       User                    @relation(fields: [createdById], references: [id])
  branch          Branch                  @relation(fields: [branchId], references: [id])
  convertedClient Client?                 @relation(fields: [convertedClientId], references: [id])
  info            ConsultationInfo?
  assessment      ConsultationAssessment?
  packages        ConsultationPackage[]
  workoutPrograms WorkoutProgram[]
  mealPlans       MealPlan[]
  salesLead       SalesLead?

  @@map("consultations")
}

model ConsultationInfo {
  id             String   @id @default(cuid())
  consultationId String   @unique
  fullName       String   @default("")
  phone          String   @default("")
  address        String?
  dateOfBirth    DateTime?
  email          String?
  consultDate    DateTime @default(now())
  knowLDFVia     String?
  referralSource String?
  familyStatus   String?
  height         Float    @default(0)
  currentWeight  Float    @default(0)
  targetWeight   Float    @default(0)
  timeToAchieve  String?
  previousAttempts String?
  currentFeeling String?
  whyNow         String?
  familySupport  String?
  motivationLevel Int?
  barriers       String?
  exerciseExperience String?
  currentDiet    String?
  mealsPerDay    Int?
  typicalMeals   String?
  snacking       String?
  diningOut      String?
  foodPreferences String?
  foodAllergies  String?
  workoutsPerWeek Int?
  availableTime  String?
  healthConditions String?
  injuries       String?
  stressLevel    Int?
  sleepQuality   String?
  goalDescription String?
  desiredPackage String?
  budget         String?
  whoPaysBill    String?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_info")
}

model ConsultationAssessment {
  id                  String  @id @default(cuid())
  consultationId      String  @unique
  waist               Float?
  hip                 Float?
  bmi                 Float?
  bmiCategory         String?
  idealWeight         String?
  whr                 Float?
  whrCategory         String?
  recommendedPackages String? @db.Text
  notes               String? @db.Text

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_assessments")
}

model ConsultationPackage {
  id             String  @id @default(cuid())
  consultationId String
  packageName    String
  packageStage   String
  sessions       Int
  durationDays   Int
  price          Float
  discountedPrice Float?
  order          Int
  isConfirmed    Boolean @default(false)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_packages")
}

model ActivityLog {
  id            String   @id @default(cuid())
  clientId      String
  date          DateTime @db.Date
  steps         Int?
  minutesActive Int?
  minutesGym    Int?
  note          String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@map("activity_logs")
}

model WeightLog {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime
  weight    Float
  note      String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("weight_logs")
}

enum Role {
  ADMIN
  FM
  CEO_FITPARTNER
  COO
  PT
}

model FMBranchAssignment {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("fm_branch_assignments")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  RESERVED
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  RESOLVED
}

model Complaint {
  id           String          @id @default(cuid())
  clientId     String
  branchId     String
  assignedFMId String?
  category     String
  content      String          @db.Text
  status       ComplaintStatus @default(PENDING)
  fmNote       String?         @db.Text
  isReadByFM   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branch     Branch  @relation(fields: [branchId], references: [id])
  assignedFM User?   @relation("FMComplaints", fields: [assignedFMId], references: [id])

  @@map("complaints")
}

model PackageEnrollment {
  id           String                  @id @default(cuid())
  clientId     String
  contractCode String?
  packageName  String
  packageStage String
  sessions     Int
  sessionsUsed   Int                     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int
  reservedDays   Int                     @default(0)
  extensionDays  Int                     @default(0)
  price          Float
  contractType   ContractType            @default(NORMAL)
  status         PackageEnrollmentStatus @default(ACTIVE)
  notes          String?                 @db.Text
  createdAt      DateTime                @default(now())

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutPrograms WorkoutProgram[]
  sessionPhotos   SessionPhoto[]
  kocContract     KOCContract?
  ptSessionAdjustments PTSessionAdjustment[]

  @@map("package_enrollments")
}

// Admin/FM chỉnh tay "Số buổi PT" của một lộ trình.
//
// "Số buổi PT" tự đếm từ workout_logs (buổi đã check-out có chữ ký kèm nhật ký
// buổi tập). Khi con số tự đếm sai — buổi dạy thật nhưng ký hỏng, dữ liệu cũ —
// Admin/FM sửa lại tổng số buổi của lộ trình ở hồ sơ khách; phần CHÊNH LỆCH được
// ghi vào đây theo THÁNG SỬA và cộng vào lương tháng đó.
//
// Lưu theo (lộ trình · tháng) nên sửa nhiều lần qua nhiều tháng vẫn cộng dồn
// đúng, và tiền chỉ rơi vào đúng tháng đã ghi nhận.
model PTSessionAdjustment {
  id           String   @id @default(cuid())
  enrollmentId String
  // PT được ghi công phần chênh lệch — PT phụ trách khách lúc sửa.
  ptId         String
  month        Int
  year         Int
  // Số buổi cộng thêm, có thể âm khi trừ bớt.
  delta        Int
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  pt         User              @relation("PTSessionAdjustments", fields: [ptId], references: [id])

  @@unique([enrollmentId, month, year])
  @@index([ptId, month, year])
  @@map("pt_session_adjustments")
}

enum PackageEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  EXPIRED
}

enum ContractType {
  NORMAL
  KOC
  KOL
}

enum KOCContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model KOCContract {
  id                    String            @id @default(cuid())
  enrollmentId          String            @unique
  clientId              String
  ptId                  String
  startWeight           Float
  endWeight             Float?
  startWeightConfirmed  Boolean           @default(false)
  endWeightConfirmed    Boolean           @default(false)
  contractDate          DateTime          @default(now())
  endDate               DateTime
  status                KOCContractStatus @default(ACTIVE)
  totalSessions         Int               @default(0)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  enrollment PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt         User              @relation("PTKOCContracts", fields: [ptId], references: [id])

  @@map("koc_contracts")
}

enum ConsultationStatus {
  DRAFT
  COMPLETED
}

enum WorkoutProgramStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

model WorkoutExercise {
  id       String @id @default(cuid())
  phase    String
  type     String
  movement String
  name     String

  @@index([phase, type, movement])
  @@map("workout_exercises")
}

model WorkoutMovementTemplate {
  id          String   @id @default(cuid())
  phaseKey    String
  sessionType String
  movement    String
  createdAt   DateTime @default(now())

  @@unique([phaseKey, sessionType, movement])
  @@map("workout_movement_templates")
}

// Lịch tập mẫu do admin thiết lập: bài tập mặc định cho mỗi chuyển động của từng
// loại buổi trong mỗi giai đoạn. PT dùng nút "Copy từ lịch mẫu" để điền nhanh.
model WorkoutScheduleTemplate {
  id          String   @id @default(cuid())
  phaseKey    String // = WorkoutPhase.name (khoá SESSION_TYPES), vd "Giai đoạn 2: Skinny Fat"
  sessionType String // vd "Full 1"
  movement    String // mã chuyển động (slot code), vd "A1. Squat"
  exercise    String // tên bài tập mặc định
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([phaseKey, sessionType, movement])
  @@map("workout_schedule_templates")
}

model WorkoutPhase {
  id           String               @id @default(cuid())
  name         String
  order        Int
  isActive     Boolean              @default(true)
  sessionTypes String[]             @default([])
  defaultReps  String               @default("15-20")
  templateKey  String               @default("")
  programs     WorkoutProgram[]
  levelAccess  PTLevelPhaseAccess[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("workout_phases")
}

model WorkoutProgram {
  id                  String               @id @default(cuid())
  clientId            String?
  consultationId      String?
  packageEnrollmentId String?
  phase               String
  phaseId             String?
  workoutType         String?
  sessionsPerWeek     Int
  currentWeek         Int                  @default(1)
  notes               String?              @db.Text
  status              WorkoutProgramStatus @default(ACTIVE)
  manualPhaseOverride Boolean              @default(false)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation      Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  packageEnrollment PackageEnrollment? @relation(fields: [packageEnrollmentId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  workoutPhase      WorkoutPhase?      @relation(fields: [phaseId], references: [id])
  sessions          WorkoutSession[]
  weeks             WorkoutWeek[]
  workoutLogs       WorkoutLog[]

  @@map("workout_programs")
}

model WorkoutWeek {
  id         String   @id @default(cuid())
  programId  String
  weekNumber Int
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  program     WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]
  workoutLogs WorkoutLog[]

  @@map("workout_weeks")
}

model WorkoutSession {
  id          String  @id @default(cuid())
  programId   String
  weekId      String?
  sessionName String
  order       Int

  program     WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  week        WorkoutWeek?      @relation(fields: [weekId], references: [id], onDelete: SetNull)
  movements   WorkoutMovement[]
  workoutLogs WorkoutLog[]

  @@map("workout_sessions")
}

model ExamQuestion {
  id        String   @id @default(cuid())
  question  String   @db.Text
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("exam_questions")
}

model ExamConfig {
  id               String   @id @default(cuid())
  numQuestions     Int      @default(10)
  passingScore     Int      @default(80)
  shuffleQuestions Boolean  @default(true)
  // Lịch thi: tắt => không ai vào thi được. Bật => chỉ thi được đúng ngày, trong khung giờ.
  // Ngày/giờ lưu dạng chuỗi theo giờ VN (UTC+7) để không lệch múi giờ server.
  scheduleEnabled  Boolean  @default(false)
  examDate         String?
  examStartTime    String   @default("00:00")
  examEndTime      String   @default("23:59")
  // Trọng số (%) 3 tiêu chí của bảng xếp hạng — tổng phải bằng 100
  rankWeightExam      Int   @default(30)
  rankWeightRevenue   Int   @default(40)
  rankWeightTransform Int   @default(30)
  updatedAt        DateTime @updatedAt

  @@map("exam_config")
}

model ExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  total     Int
  passed    Boolean
  answers   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model UpgradeNotification {
  id        String    @id @default(cuid())
  userId    String
  userName  String
  passed    Boolean
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upgrade_notifications")
}

model WorkoutMovement {
  id               String @id @default(cuid())
  sessionId        String
  movementCode     String
  movementName     String
  selectedExercise String
  sets             Int
  reps             String
  order            Int

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setLogs WorkoutSetLog[]

  @@map("workout_movements")
}

// Lifecycle of a workout session, used for the check-in/check-out anti-cheat flow.
// Legacy/manually saved logs default to COMPLETED so existing counts stay intact.
// AWAITING_CONFIRMATION = PT finished, waiting for the client to confirm on their app.
enum WorkoutLogStatus {
  IN_PROGRESS
  AWAITING_CONFIRMATION
  COMPLETED
  VOID
}

// How a completed session was confirmed by the client.
// CLIENT_APP = client tapped confirm on their own device (strong, anti-forgery).
// SIGNATURE  = client signed on the PT's device (fallback, weaker — flagged for review).
enum WorkoutConfirmMethod {
  CLIENT_APP
  SIGNATURE
}

model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  programId   String
  weekId      String
  sessionId   String
  sessionDate DateTime @default(now())
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  // ── Check-in / check-out tracking (server-authoritative timestamps) ──
  status             WorkoutLogStatus @default(COMPLETED)
  checkInAt          DateTime?
  checkOutAt         DateTime?
  // First time the PT entered any set data; used to enforce the "interaction
  // within 10 minutes of check-in" rule.
  firstInteractionAt DateTime?
  // Client's hand-drawn signature at CHECK-OUT (proof PT taught → counts for salary).
  signatureUrl       String?          @db.Text
  // Client's hand-drawn signature at CHECK-IN (proof client showed up → deducts package).
  checkInSignatureUrl String?         @db.Text
  // Whether this log has already incremented the package's sessionsUsed. Set at
  // check-in (when the client signs in); used to reverse exactly once on delete/void.
  packageCounted     Boolean          @default(false)
  // Which package enrollment this session was charged against (the one whose
  // sessionsUsed was incremented at check-in). Recorded so delete/void reverses
  // the exact same lộ trình even when the client has several active packages.
  packageEnrollmentId String?
  // Client tapped "đồng ý kết thúc buổi sớm" in their own app: lets the PT check
  // out and count the teaching session without the usual min-duration / 6-exercise
  // gates (e.g. khách có việc, chỉ tập được 30' nhưng vẫn đồng ý tính buổi).
  earlyEndApprovedAt DateTime?
  // How/when the client confirmed the session (drives sessionsUsed increment).
  confirmationMethod WorkoutConfirmMethod?
  confirmedAt        DateTime?
  // Reason a session was voided (e.g. no interaction within 10 minutes).
  voidReason         String?

  // ── Đánh giá buổi tập (autoregulation) — PT bắt buộc làm trước khi ký
  // check-out. 3 trục: hiệu suất / cảm giác nỗ lực (RIR) / hồi phục. Từ đó sinh
  // gợi ý điều chỉnh tải cho BUỔI SAU (lưu ở nextSessionSuggestion, hiển thị đầu
  // buổi kế tiếp cùng loại). Xem lib/session-evaluation.ts.
  surveyPerformance     String?
  surveyRirFeel         String?
  surveyRecovery        String?
  nextSessionSuggestion String? @db.Text

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  week      WorkoutWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdById], references: [id])
  setLogs      WorkoutSetLog[]
  notification WorkoutNotification?

  @@map("workout_logs")
}

