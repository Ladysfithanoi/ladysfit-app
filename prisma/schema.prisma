  totalRevenue        Float        @default(0)
  commissionRate      Float        @default(0)
  commissionAmount    Float        @default(0)
  seniorityBonus      Float        @default(0)
  showsL1L2Loyal      Int          @default(0)
  showsL3L4L5         Int          @default(0)
  // Buổi dạy gói tài trợ "Cư dân" — 35.000đ/buổi
  showsResident       Int          @default(0)
  // Buổi dạy gói trải nghiệm "L0" (4 buổi / 2 triệu) — 50.000đ/buổi
  showsL0             Int          @default(0)
  // FM: dòng này có hưởng hoa hồng doanh số cả phòng không. Hoa hồng FM tính trên
  // doanh số CẢ PHÒNG nên cơ sở có nhiều FM mà ai cũng hưởng thì phòng trả nhiều
  // lần — người tạo bảng lương chọn ai được hưởng. PT/Admin không dùng cờ này.
  branchCommission    Boolean      @default(true)
  showPay             Float        @default(0)
  goalBonus           Float        @default(0)
  clientsAchievedGoal Int          @default(0)
  googleBonus         Float        @default(0)
  googleReviews       Int          @default(0)
  renewBonus          Float        @default(0)
  renewContracts      Int          @default(0)
  fixedAllowances     Float        @default(0)
  // Ngày công. Chuẩn = số ngày của tháng − số Chủ nhật (26–27 ngày). Thực tế do
  // FM nhập. Lương cứng (lương CB + phụ cấp) được chia theo thực tế / chuẩn;
  // hoa hồng, tiền buổi dạy và thưởng không bị chia. Xem lib/work-days.ts.
  standardWorkDays    Int          @default(0)
  // Float vì nghỉ nửa ngày chỉ trừ 0,5 ngày công.
  actualWorkDays      Float        @default(0)
  // Số ngày công bị trừ theo lịch nghỉ (leave_days) tại lần tính gần nhất: nghỉ
  // thường 1 ngày, nghỉ nửa ngày 0,5 ngày; nghỉ phép năm không tính vào đây vì
  // vẫn hưởng đủ lương. Khi lịch nghỉ đổi, ngày công thực tế được trừ đúng phần
  // chênh lệch nên số FM sửa tay vẫn giữ. Xem lib/leave-days.ts.
  leaveDays           Float        @default(0)
  bhxh                Float        @default(0)
  totalSalary         Float        @default(0)
  kocCommission       Float        @default(0)
  kolCommission       Float        @default(0)
  advancePaid         Float        @default(0)
  remainingPayment    Float        @default(0)
  notes               String?      @db.Text
  sessionImages       String?      @db.Text
  status              SalaryStatus @default(PENDING)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user   User   @relation("UserSalaryRecords", fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, month, year])
  @@map("salary_records")
}

// ── Lịch nghỉ ─────────────────────────────────────────────────────────────

/// Nghỉ phép năm vẫn hưởng đủ lương; nghỉ thường thì trừ ngày công.
enum LeaveType {
  ANNUAL
  UNPAID
  HALF_DAY
}

/// Một ngày nghỉ của nhân sự, tích trực tiếp trên lịch. Nghỉ thường (UNPAID)
/// trừ 1 ngày công, nghỉ nửa ngày (HALF_DAY) trừ 0,5 ngày công, phép năm
/// (ANNUAL) không trừ gì. Chủ nhật không tích được vì vốn không tính công.
model LeaveDay {
  id          String   @id @default(cuid())
  userId      String
  /// Ngày nghỉ, chỉ phần ngày — luôn dựng bằng UTC để khớp cột DATE của Postgres.
  date        DateTime @db.Date
  /// Phép năm (đủ lương), nghỉ thường (trừ 1 công) hay nghỉ nửa ngày (trừ 0,5
  /// công). Xem lib/leave-days.ts.
  type        LeaveType @default(UNPAID)
  note        String?
  /// Người tích lịch: chính nhân sự đó, FM của cơ sở hoặc Admin.
  createdById String
  createdAt   DateTime @default(now())

  user      User @relation("UserLeaveDays", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("LeaveDayCreator", fields: [createdById], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
  @@map("leave_days")
}

