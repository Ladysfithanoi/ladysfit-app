generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users           User[]
  clients         Client[]
  consultations   Consultation[]
  fmAssignments   FMBranchAssignment[]
  complaints      Complaint[]
  salesLeads      SalesLead[]
  monthlyTargets  MonthlyTarget[]
  weeklyReports        WeeklyReport[]
  monthlyBranchReports MonthlyBranchReport[]
  salaryConfigs        SalaryConfig[]
  salaryRecords        SalaryRecord[]
  transactions         Transaction[]

  @@map("branches")
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(PT)
  branchId        String?
  freeUpgradedAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dateOfBirth           DateTime?
  ptLevelId             String?
  deletedAt             DateTime?
  ptLevel               PTLevel?             @relation("UserPTLevel", fields: [ptLevelId], references: [id])

  branch                Branch?              @relation(fields: [branchId], references: [id])
  accounts              Account[]
  sessions              Session[]
  clients               Client[]
  consultations         Consultation[]
  managedBranches       FMBranchAssignment[]
  workoutPrograms       WorkoutProgram[]
  workoutLogs           WorkoutLog[]
  examAttempts          ExamAttempt[]
  upgradeNotifications  UpgradeNotification[]
  mealPlans             MealPlan[]
  ptAlerts              PerformanceAlert[] @relation("PTPerformanceAlerts")
  assignedComplaints    Complaint[]        @relation("FMComplaints")
  assignedLeads         SalesLead[]        @relation("AssignedPTLeads")
  createdLeads          SalesLead[]        @relation("CreatedLeads")
  monthlyTargets        MonthlyTarget[]    @relation("PTMonthlyTargets")
  weeklyReports         WeeklyReport[]        @relation("FMWeeklyReports")
  monthlyBranchReports  MonthlyBranchReport[] @relation("FMMonthlyReports")
  dailyChecklists       DailyChecklist[]      @relation("UserDailyChecklists")
  weeklyMonthlyReports  WeeklyMonthlyReport[] @relation("UserWeeklyMonthlyReports")
  salaryConfigs         SalaryConfig[]        @relation("UserSalaryConfigs")
  salaryRecords         SalaryRecord[]        @relation("UserSalaryRecords")
  transactions          Transaction[]         @relation("TransactionCreator")
  checklistNotifications  ChecklistNotification[]
  measuredBodyLogs        BodyMeasurementLog[]         @relation("MeasuredByUser")
  measurementNotifications MeasurementNotification[]   @relation("PTMeasurementNotifs")
  ptSessionPhotos         SessionPhoto[]               @relation("PTSessionPhotos")
  kocContracts            KOCContract[]                @relation("PTKOCContracts")
  substituteRequestsMade     SubstituteRequest[]          @relation("RequesterSub")
  substituteRequestsReceived SubstituteRequest[]          @relation("SubstituteSub")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Client {
  id               String       @id @default(cuid())
  clientCode       String?      @unique
  fullName         String
  phone            String
  email            String?      @unique
  password         String?
  passwordSetAt    DateTime?
  dateOfBirth      DateTime?
  initialWeight    Float
  currentWeight    Float
  targetWeight     Float
  height           Float
  initialWaist     Float?
  initialHip       Float?
  healthConditions String?      @db.Text
  injuries         String?      @db.Text
  targetDate       DateTime?
  goalNote         String?      @db.Text
  myPlateImageUrl  String?      @db.Text
  myPlateNote      String?
  avatarUrl        String?      @db.Text
  assignedPTId     String
  branchId         String
  dietPhase        String       @default("Giai đoạn 1")
  status           ClientStatus @default(ACTIVE)
  hasTransformed   Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedPT    User           @relation(fields: [assignedPTId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  weightLogs          WeightLog[]
  activityLogs        ActivityLog[]
  consultations       Consultation[]
  packageEnrollments  PackageEnrollment[]
  workoutPrograms     WorkoutProgram[]
  workoutLogs         WorkoutLog[]
  mealPlans             MealPlan[]
  foodScanLogs          FoodScanLog[]
  performanceAlerts     PerformanceAlert[]
  workoutNotifications  WorkoutNotification[]
  complaints                   Complaint[]
  bodyMeasurementLogs          BodyMeasurementLog[]
  measurementNotifications     MeasurementNotification[]
  sessionPhotos                SessionPhoto[]              @relation("ClientSessionPhotos")
  kocContracts                 KOCContract[]
  substituteRequests           SubstituteRequest[]

  @@map("clients")
}

model Consultation {
  id                String             @id @default(cuid())
  status            ConsultationStatus @default(DRAFT)
  currentStep       Int                @default(1)
  createdById       String
  branchId          String
  convertedClientId String?
  workoutDesignJson String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  createdBy       User                    @relation(fields: [createdById], references: [id])
  branch          Branch                  @relation(fields: [branchId], references: [id])
  convertedClient Client?                 @relation(fields: [convertedClientId], references: [id])
  info            ConsultationInfo?
  assessment      ConsultationAssessment?
  packages        ConsultationPackage[]
  workoutPrograms WorkoutProgram[]
  mealPlans       MealPlan[]
  salesLead       SalesLead?

  @@map("consultations")
}

model ConsultationInfo {
  id             String   @id @default(cuid())
  consultationId String   @unique
  fullName       String   @default("")
  phone          String   @default("")
  address        String?
  dateOfBirth    DateTime?
  email          String?
  consultDate    DateTime @default(now())
  knowLDFVia     String?
  referralSource String?
  familyStatus   String?
  height         Float    @default(0)
  currentWeight  Float    @default(0)
  targetWeight   Float    @default(0)
  timeToAchieve  String?
  previousAttempts String?
  currentFeeling String?
  whyNow         String?
  familySupport  String?
  motivationLevel Int?
  barriers       String?
  exerciseExperience String?
  currentDiet    String?
  mealsPerDay    Int?
  typicalMeals   String?
  snacking       String?
  diningOut      String?
  foodPreferences String?
  foodAllergies  String?
  workoutsPerWeek Int?
  availableTime  String?
  healthConditions String?
  injuries       String?
  stressLevel    Int?
  sleepQuality   String?
  goalDescription String?
  desiredPackage String?
  budget         String?
  whoPaysBill    String?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_info")
}

model ConsultationAssessment {
  id                  String  @id @default(cuid())
  consultationId      String  @unique
  waist               Float?
  hip                 Float?
  bmi                 Float?
  bmiCategory         String?
  idealWeight         String?
  whr                 Float?
  whrCategory         String?
  recommendedPackages String? @db.Text
  notes               String? @db.Text

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_assessments")
}

model ConsultationPackage {
  id             String  @id @default(cuid())
  consultationId String
  packageName    String
  packageStage   String
  sessions       Int
  durationDays   Int
  price          Float
  discountedPrice Float?
  order          Int
  isConfirmed    Boolean @default(false)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_packages")
}

model ActivityLog {
  id            String   @id @default(cuid())
  clientId      String
  date          DateTime @db.Date
  steps         Int?
  minutesActive Int?
  minutesGym    Int?
  note          String?
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@map("activity_logs")
}

model WeightLog {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime
  weight    Float
  note      String?
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("weight_logs")
}

enum Role {
  ADMIN
  FM
  CEO_FITPARTNER
  COO
  PT
}

model FMBranchAssignment {
  id         String   @id @default(cuid())
  userId     String
  branchId   String
  assignedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("fm_branch_assignments")
}

enum ClientStatus {
  ACTIVE
  PAUSED
  RESERVED
}

enum ComplaintStatus {
  PENDING
  PROCESSING
  RESOLVED
}

model Complaint {
  id           String          @id @default(cuid())
  clientId     String
  branchId     String
  assignedFMId String?
  category     String
  content      String          @db.Text
  status       ComplaintStatus @default(PENDING)
  fmNote       String?         @db.Text
  isReadByFM   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branch     Branch  @relation(fields: [branchId], references: [id])
  assignedFM User?   @relation("FMComplaints", fields: [assignedFMId], references: [id])

  @@map("complaints")
}

model PackageEnrollment {
  id           String                  @id @default(cuid())
  clientId     String
  contractCode String?
  packageName  String
  packageStage String
  sessions     Int
  sessionsUsed   Int                     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  durationDays   Int
  reservedDays   Int                     @default(0)
  extensionDays  Int                     @default(0)
  price          Float
  contractType   ContractType            @default(NORMAL)
  status         PackageEnrollmentStatus @default(ACTIVE)
  notes          String?                 @db.Text
  createdAt      DateTime                @default(now())

  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutPrograms WorkoutProgram[]
  sessionPhotos   SessionPhoto[]
  kocContract     KOCContract?

  @@map("package_enrollments")
}

enum PackageEnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  EXPIRED
}

enum ContractType {
  NORMAL
  KOC
  KOL
}

enum KOCContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model KOCContract {
  id                    String            @id @default(cuid())
  enrollmentId          String            @unique
  clientId              String
  ptId                  String
  startWeight           Float
  endWeight             Float?
  startWeightConfirmed  Boolean           @default(false)
  endWeightConfirmed    Boolean           @default(false)
  contractDate          DateTime          @default(now())
  endDate               DateTime
  status                KOCContractStatus @default(ACTIVE)
  totalSessions         Int               @default(0)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  enrollment PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt         User              @relation("PTKOCContracts", fields: [ptId], references: [id])

  @@map("koc_contracts")
}

enum ConsultationStatus {
  DRAFT
  COMPLETED
}

enum WorkoutProgramStatus {
  ACTIVE
  ARCHIVED
}

model WorkoutExercise {
  id       String @id @default(cuid())
  phase    String
  type     String
  movement String
  name     String

  @@index([phase, type, movement])
  @@map("workout_exercises")
}

model WorkoutMovementTemplate {
  id          String   @id @default(cuid())
  phaseKey    String
  sessionType String
  movement    String
  createdAt   DateTime @default(now())

  @@unique([phaseKey, sessionType, movement])
  @@map("workout_movement_templates")
}

model WorkoutPhase {
  id           String               @id @default(cuid())
  name         String
  order        Int
  isActive     Boolean              @default(true)
  sessionTypes String[]             @default([])
  defaultReps  String               @default("15-20")
  templateKey  String               @default("")
  programs     WorkoutProgram[]
  levelAccess  PTLevelPhaseAccess[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("workout_phases")
}

model WorkoutProgram {
  id                  String               @id @default(cuid())
  clientId            String?
  consultationId      String?
  packageEnrollmentId String?
  phase               String
  phaseId             String?
  workoutType         String?
  sessionsPerWeek     Int
  currentWeek         Int                  @default(1)
  notes               String?              @db.Text
  status              WorkoutProgramStatus @default(ACTIVE)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation      Consultation?      @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  packageEnrollment PackageEnrollment? @relation(fields: [packageEnrollmentId], references: [id])
  createdBy         User               @relation(fields: [createdById], references: [id])
  workoutPhase      WorkoutPhase?      @relation(fields: [phaseId], references: [id])
  sessions          WorkoutSession[]
  weeks             WorkoutWeek[]
  workoutLogs       WorkoutLog[]

  @@map("workout_programs")
}

model WorkoutWeek {
  id         String   @id @default(cuid())
  programId  String
  weekNumber Int
  notes      String?  @db.Text
  createdAt  DateTime @default(now())

  program     WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]
  workoutLogs WorkoutLog[]

  @@map("workout_weeks")
}

model WorkoutSession {
  id          String  @id @default(cuid())
  programId   String
  weekId      String?
  sessionName String
  order       Int

  program     WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  week        WorkoutWeek?      @relation(fields: [weekId], references: [id], onDelete: SetNull)
  movements   WorkoutMovement[]
  workoutLogs WorkoutLog[]

  @@map("workout_sessions")
}

model ExamQuestion {
  id        String   @id @default(cuid())
  question  String   @db.Text
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  correct   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("exam_questions")
}

model ExamConfig {
  id               String   @id @default(cuid())
  numQuestions     Int      @default(10)
  passingScore     Int      @default(80)
  shuffleQuestions Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("exam_config")
}

model ExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  total     Int
  passed    Boolean
  answers   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exam_attempts")
}

model UpgradeNotification {
  id        String    @id @default(cuid())
  userId    String
  userName  String
  passed    Boolean
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("upgrade_notifications")
}

model WorkoutMovement {
  id               String @id @default(cuid())
  sessionId        String
  movementCode     String
  movementName     String
  selectedExercise String
  sets             Int
  reps             String
  order            Int

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  setLogs WorkoutSetLog[]

  @@map("workout_movements")
}

model WorkoutLog {
  id          String   @id @default(cuid())
  clientId    String
  programId   String
  weekId      String
  sessionId   String
  sessionDate DateTime @default(now())
  notes       String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  program   WorkoutProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  week      WorkoutWeek    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy    User                  @relation(fields: [createdById], references: [id])
  setLogs      WorkoutSetLog[]
  notification WorkoutNotification?

  @@map("workout_logs")
}

// ── Nutrition ─────────────────────────────────────────────────────────────

enum MealPlanStatus {
  ACTIVE
  ARCHIVED
}

model MealPlan {
  id             String         @id @default(cuid())
  clientId       String?
  consultationId String?
  tdee           Float
  der            Float
  protein        Float
  fat            Float
  carbs          Float
  mealsPerDay    Int
  likes          String?        @db.Text
  dislikes       String?        @db.Text
  status         MealPlanStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdBy    User          @relation(fields: [createdById], references: [id])
  days         MealPlanDay[]

  @@map("meal_plans")
}

model MealPlanDay {
  id            String   @id @default(cuid())
  mealPlanId    String
  dayLabel      String
  meals         String   @db.Text
  totalCalories Float
  totalProtein  Float
  totalFat      Float
  totalCarbs    Float
  createdAt     DateTime @default(now())

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@map("meal_plan_days")
}

model FoodScanLog {
  id        String   @id @default(cuid())
  clientId  String
  scanDate  DateTime @default(now())
  foodName  String
  quantity  String
  calories  Float
  protein   Float
  fat       Float
  carbs     Float
  imageUrl  String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("food_scan_logs")
}

// ── Workout Notifications ─────────────────────────────────────────────────

model WorkoutNotification {
  id               String   @id @default(cuid())
  clientId         String
  workoutLogId     String   @unique
  message          String   @db.Text
  nextSessionName  String?
  nextSessionPhase String?
  isRead           Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)

  @@map("workout_notifications")
}

// ── Performance Alerts ────────────────────────────────────────────────────

enum AlertType {
  SLOW_PROGRESS
  NO_WEIGH_IN
}

model PerformanceAlert {
  id            String    @id @default(cuid())
  clientId      String
  ptId          String
  alertType     AlertType
  weekStart     DateTime
  expectedRate  Float?
  actualRate    Float?
  weeksAnalyzed Int?
  note          String?   @db.Text
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pt     User   @relation("PTPerformanceAlerts", fields: [ptId], references: [id])

  @@map("performance_alerts")
}

model WorkoutSetLog {
  id            String  @id @default(cuid())
  workoutLogId  String
  movementId    String?
  movementName  String
  exerciseName  String
  set1Load      String?
  set1Reps      String?
  set2Load      String?
  set2Reps      String?
  set3Load      String?
  set3Reps      String?
  set4Load      String?
  set4Reps      String?
  set5Load      String?
  set5Reps      String?
  set6Load      String?
  set6Reps      String?
  exerciseNotes String? @db.Text

  workoutLog WorkoutLog       @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  movement   WorkoutMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  @@map("workout_set_logs")
}

// ── Setup Doanh số ────────────────────────────────────────────────────────

enum LeadStatus {
  TAKECARE
  FAIL
  DE
  PIF
  PB
}

model SalesLead {
  id                String     @id @default(cuid())
  branchId          String
  assignedPTId      String
  createdById       String
  customerName      String
  yearOfBirth       Int?
  phone             String?
  source            String?
  referralSource    String?
  notes             String?    @db.Text
  forecast          String?
  status            LeadStatus @default(TAKECARE)
  packageRegistered String?
  actualRevenue       Float?
  remainingPayment    Float?
  fitpartnerRevenue   Float?
  signDate            DateTime?
  remark              String?
  month             Int
  year              Int
  consultationId    String?    @unique
  syncedClientId    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id])
  assignedPT   User          @relation("AssignedPTLeads", fields: [assignedPTId], references: [id])
  createdBy    User          @relation("CreatedLeads", fields: [createdById], references: [id])
  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@map("sales_leads")
}

model MonthlyTarget {
  id                 String   @id @default(cuid())
  branchId           String
  userId             String
  month              Int
  year               Int
  revenueTarget             Float    @default(0)
  fitpartnerRevenueTarget   Float    @default(0)
  fitTarget                 Int      @default(0)
  cooperationTarget         Int      @default(0)
  transformTarget           Int      @default(0)
  googleReviewTarget        Int      @default(0)
  cvTarget                  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id])
  user          User           @relation("PTMonthlyTargets", fields: [userId], references: [id])
  weeklyActuals WeeklyActual[]

  @@unique([branchId, userId, month, year])
  @@map("monthly_targets")
}

model WeeklyActual {
  id                  String   @id @default(cuid())
  monthlyTargetId     String
  weekNumber          Int
  weekStart           DateTime
  weekEnd             DateTime
  revenueActual              Float    @default(0)
  fitpartnerRevenueActual    Float    @default(0)
  fitActual                  Int      @default(0)
  cooperationActual          Int      @default(0)
  transformActual            Int      @default(0)
  googleReviewActual         Int      @default(0)
  cvActual                   Int      @default(0)
  weeklyTaskNotes     String?  @db.Text
  // Per-week individual targets (set in targets tab, mapped to weekly report)
  revenueTarget              Float    @default(0)
  fitpartnerRevenueTarget    Float    @default(0)
  fitTarget                  Int      @default(0)
  cooperationTarget          Int      @default(0)
  transformTarget            Int      @default(0)
  googleReviewTarget         Int      @default(0)
  cvTarget                   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  monthlyTarget MonthlyTarget @relation(fields: [monthlyTargetId], references: [id], onDelete: Cascade)

  @@unique([monthlyTargetId, weekNumber])
  @@map("weekly_actuals")
}

model WeeklyReport {
  id             String   @id @default(cuid())
  branchId       String
  month          Int
  year           Int
  weekNumber     Int
  importantTasks   String?  @db.Text
  arisingTasks     String?  @db.Text
  incompleteWork   String?  @db.Text
  solutions        String?  @db.Text
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("FMWeeklyReports", fields: [createdById], references: [id])

  @@unique([branchId, month, year, weekNumber])
  @@map("weekly_reports")
}

model MonthlyBranchReport {
  id             String   @id @default(cuid())
  branchId       String
  month          Int
  year           Int
  incompleteWork String?  @db.Text
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("FMMonthlyReports", fields: [createdById], references: [id])

  @@unique([branchId, month, year])
  @@map("monthly_branch_reports")
}

// ── Check-list Nhân sự ────────────────────────────────────────────────────

enum ReportType {
  WEEKLY
  MONTHLY
}

model DailyChecklist {
  id               String   @id @default(cuid())
  userId           String
  reportDate       DateTime
  position         String   @default("")
  targetNote       String?
  totalTarget      Float?
  dailyResults     String?  @db.Text
  dailyCompleted   String?  @db.Text
  dailyIncomplete  String?  @db.Text
  dailyNextPlan    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user  User            @relation("UserDailyChecklists", fields: [userId], references: [id])
  items ChecklistItem[]

  @@map("daily_checklists")
}

model ChecklistItem {
  id           String   @id @default(cuid())
  checklistId  String
  order        Int
  time         String?
  task         String
  kpi          String?
  actualResult Float?
  note         String?
  createdAt    DateTime @default(now())

  checklist DailyChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

// ── Checklist Notifications ───────────────────────────────────────────────

enum ChecklistNotifType {
  REMINDER
  DAILY_REPORT
  LEAD_REMINDER
  SUBSTITUTE_REQUEST
}

model ChecklistNotification {
  id        String             @id @default(cuid())
  userId    String
  type      ChecklistNotifType
  message   String             @db.Text
  isRead    Boolean            @default(false)
  date      DateTime
  relatedId String?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checklist_notifications")
}

model WeeklyMonthlyReport {
  id             String     @id @default(cuid())
  userId         String
  reportType     ReportType
  month          Int
  year           Int
  weekNumber     Int?
  importantTasks String     @db.Text @default("[]")
  results        String?    @db.Text
  completed      String?    @db.Text
  incomplete     String?    @db.Text
  nextPlan       String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user User @relation("UserWeeklyMonthlyReports", fields: [userId], references: [id])

  @@map("weekly_monthly_reports")
}

// ── Quỹ lương ─────────────────────────────────────────────────────────────

enum SalaryStatus {
  PENDING
  CONFIRMED
  PAID
}

model SalaryConfig {
  id                 String    @id @default(cuid())
  userId             String
  branchId           String
  baseSalary         Float     @default(0)
  commissionTiers    String    @db.Text @default("[]")
  seniorityYears     Int       @default(0)
  startDate          DateTime?
  lunchAllowance     Float     @default(2600000)
  phoneAllowance     Float     @default(900000)
  transportAllowance Float     @default(500000)
  effectiveFrom      DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user   User   @relation("UserSalaryConfigs", fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@map("salary_configs")
}

model SalaryRecord {
  id                  String       @id @default(cuid())
  userId              String
  branchId            String
  month               Int
  year                Int
  baseSalary          Float        @default(0)
  totalRevenue        Float        @default(0)
  commissionRate      Float        @default(0)
  commissionAmount    Float        @default(0)
  seniorityBonus      Float        @default(0)
  showsL1L2Loyal      Int          @default(0)
  showsL3L4L5         Int          @default(0)
  showPay             Float        @default(0)
  goalBonus           Float        @default(0)
  clientsAchievedGoal Int          @default(0)
  googleBonus         Float        @default(0)
  googleReviews       Int          @default(0)
  renewBonus          Float        @default(0)
  renewContracts      Int          @default(0)
  fixedAllowances     Float        @default(0)
  bhxh                Float        @default(0)
  totalSalary         Float        @default(0)
  kocCommission       Float        @default(0)
  kolCommission       Float        @default(0)
  advancePaid         Float        @default(0)
  remainingPayment    Float        @default(0)
  notes               String?      @db.Text
  sessionImages       String?      @db.Text
  status              SalaryStatus @default(PENDING)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user   User   @relation("UserSalaryRecords", fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, month, year])
  @@map("salary_records")
}

// ── Transform Gallery ────────────────────────────────────────────────────

model TransformPhoto {
  id             String   @id @default(cuid())
  weightBefore   Float
  weightAfter    Float
  durationMonths Int
  imageUrl       String
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@map("transform_photos")
}

// ── Thông báo số đo ──────────────────────────────────────────────────────

model MeasurementNotification {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation("PTMeasurementNotifs", fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("measurement_notifications")
}

// ── Số đo cơ thể ──────────────────────────────────────────────────────────

model BodyMeasurementLog {
  id             String    @id @default(cuid())
  clientId       String
  measuredById   String?
  measuredDate   DateTime  @db.Date
  waist          Float?
  belly          Float?
  armSize        Float?
  armFromElbow   Float?
  thighSize      Float?
  thighFromKnee  Float?
  calfSize       Float?
  calfFromKnee   Float?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  measuredBy User?  @relation("MeasuredByUser", fields: [measuredById], references: [id], onDelete: SetNull)

  @@map("body_measurement_logs")
}

// ── Thu Chi ───────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id              String          @id @default(cuid())
  branchId        String
  type            TransactionType
  category        String
  amount          Float
  description     String?
  transactionDate DateTime
  referenceId     String?
  receiptImages   String?         @db.Text
  invoiceImages   String?         @db.Text
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("TransactionCreator", fields: [createdById], references: [id])

  @@index([branchId, transactionDate])
  @@map("transactions")
}

// ── Session Photos (per-PT per-enrollment per-month) ──────────────────────────

model SessionPhoto {
  id                  String   @id @default(cuid())
  ptId                String
  clientId            String
  packageEnrollmentId String
  month               Int
  year                Int
  checkinImages       String?  @db.Text
  transformImages     String?  @db.Text
  hasTransformed      Boolean  @default(false)
  createdAt           DateTime @default(now())

  pt                User              @relation("PTSessionPhotos", fields: [ptId], references: [id], onDelete: Cascade)
  client            Client            @relation("ClientSessionPhotos", fields: [clientId], references: [id], onDelete: Cascade)
  packageEnrollment PackageEnrollment @relation(fields: [packageEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([ptId, packageEnrollmentId, month, year])
  @@map("session_photos")
}

// ── PT Level System ───────────────────────────────────────────────────────────

model PTLevel {
  id                 String               @id @default(cuid())
  name               String
  order              Int
  color              String               @default("#6b7280")
  retestIntervalDays Int                  @default(30)
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  phaseAccess        PTLevelPhaseAccess[]
  users              User[]               @relation("UserPTLevel")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@map("pt_levels")
}

model PTLevelPhaseAccess {
  id        String       @id @default(cuid())
  levelId   String
  level     PTLevel      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  phaseId   String
  phase     WorkoutPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  hasAccess Boolean      @default(true)

  @@unique([levelId, phaseId])
  @@map("pt_level_phase_access")
}

model SystemConfig {
  id                String   @id
  enableLevelSystem Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("system_config")
}

// ── Substitute Teaching ───────────────────────────────────────────────────────

enum SubType {
  SHORT_TERM
  LONG_TERM
}

enum SubStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

model SubstituteRequest {
  id            String    @id @default(cuid())
  clientId      String
  requestedById String
  substituteId  String
  type          SubType
  startDate     DateTime  @default(now())
  endDate       DateTime?
  durationDays  Int?
  status        SubStatus @default(PENDING)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequesterSub", fields: [requestedById], references: [id])
  substitute  User   @relation("SubstituteSub", fields: [substituteId], references: [id])

  @@map("substitute_requests")
}

// ── Hướng dẫn sử dụng ────────────────────────────────────────────────────────

model UserGuide {
  id         String   @id @default(cuid())
  title      String
  roleGroup  String   @default("PT")
  category   String
  youtubeUrl String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_guides")
}

// ── Cơ sở dữ liệu thực phẩm (thay thế USDA) ────────────────────────────────

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  weight_g  Float    @default(100)
  category  String?
  meal_type String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("foods")
}
